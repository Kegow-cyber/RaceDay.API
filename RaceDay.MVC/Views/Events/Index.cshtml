@model List<RaceDay.MVC.Models.EventViewModel>
<h2>RaceDay Events (from API)</h2>
@if(Model == null || !Model.Any()){
    <p>No events found. Make sure API is running on http://localhost:5195</p>
} else {
<table class="table">
<tr><th>Id</th><th>Name</th><th>Location</th><th>Date</th></tr>
@foreach(var e in Model){
<tr><td>@e.Id</td><td>@e.Name</td><td>@e.Location</td><td>@e.Date</td></tr>
}
</table>
}